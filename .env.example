# Copy to .env and adjust. This file contains NO secrets - those live in ./secrets/ (see secrets/README.md).

# Public https address of the app. Google redirects back to
#   ${APP_BASE_URL}/api/google/oauth/callback
# This exact URI must be registered in the Google Cloud OAuth client.
APP_BASE_URL=https://calsync.example.org

# Where the container port is published on the host. Keep 127.0.0.1 when a reverse proxy runs
# on the same host; use 0.0.0.0 only if the proxy is elsewhere and the port is firewalled.
HOST_BIND=127.0.0.1
HOST_PORT=8000

# IP addresses of the reverse proxy that may set X-Forwarded-For/-Proto ("*" = trust all, not recommended).
# With the bundled Caddy profile use the docker network range, e.g. 172.16.0.0/12.
FORWARDED_ALLOW_IPS=127.0.0.1

# Only for the optional Caddy profile (docker compose --profile caddy up -d)
PUBLIC_HOSTNAME=calsync.example.org

ADMIN_USERNAME=admin
SESSION_TTL_HOURS=12
LOG_LEVEL=INFO
